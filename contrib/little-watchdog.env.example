# little-watchdog config. Mode 0660, root:little-wd, in a setgid directory (tmpfiles.d/little-wd.conf):
# it contains the bot token, so nobody outside the group may read it.
# Syntax: KEY=value, one per line, '#' only at line start. No quoting, no shell.

TELEGRAM_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=123456789
#TELEGRAM_API_URL=https://api.telegram.org

# Dead-man's switch (Healthchecks style). Empty = off. Period in HC = DEADMAN_EVERY, grace >= 2x.
# DEADMAN_EVERY: at least 60s.
#DEADMAN_URL=https://hc.example.org/ping/your-uuid
#DEADMAN_EVERY=2m

#INTERVAL=60s
#FAIL_AFTER=3
#RECOVER_AFTER=2
#TIMEOUT=10s
#STATE_FILE=/var/lib/little-watchdog/state.json

# Checks. NAME = [A-Z0-9_]+, unique across all types.
HTTP_NEXTCLOUD=https://cloud.example.org/status.php contains=installed
TCP_SSH=192.0.2.5:22
HOST_NAS=192.0.2.20:445

# Own host. A threshold of 0 switches that check off; DISK_PATHS= (empty) = no disk checks.
# Mount points only: a plain directory on the parent's device reports "not mounted".
#DISK_PATHS=/,/data
#DISK_MIN_FREE_PCT=10
#MEM_MIN_AVAIL_PCT=5
#TEMP_MAX_C=85
#TEMP_SENSOR=
#CPU_MAX_PCT=90
#CPU_WINDOW=15m
