[Unit]
Description=little-watchdog homelab watchdog
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/little-wd run
ExecReload=/bin/kill -HUP $MAINPID
# With transparent huge pages set to "always", the kernel backs the small Go heap
# with 2 MB pages: about 2.5 MB more RSS, at random. The Go runtime opts out here.
Environment=GODEBUG=disablethp=1
Restart=always
RestartSec=10

# User and group come from sysusers.d/little-wd.conf; /etc/little-watchdog (setgid, group
# little-wd) from tmpfiles.d/little-wd.conf. The daemon only reads the config, so
# ProtectSystem=strict keeps /etc read-only for it although the group may write there.
User=little-wd
Group=little-wd
StateDirectory=little-watchdog
StateDirectoryMode=0750
# /run/little-watchdog for STATE_IN_RAM=yes (little-wd, Settings): owned by little-wd, the group
# reads it like the state directory. Kept across a restart (also the automatic one), gone with a
# reboot or a stop. Empty and unused while the state is on disk.
RuntimeDirectory=little-watchdog
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
ProtectSystem=strict
# read-only, not yes: with yes, a disk check on /home sees an empty tmpfs
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
# own, empty /dev/shm and SysV IPC, removed on stop: nothing shared, no place to hide state
PrivateIPC=yes
RemoveIPC=yes
ProtectProc=invisible
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# no AF_UNIX: the resolver is pure Go and logging uses the inherited stderr
RestrictAddressFamilies=AF_INET AF_INET6
# nothing here listens: no bind() to any port (ping, HTTP and Telegram only connect)
SocketBindDeny=any
# a user namespace with only root, little-wd and its group mapped
PrivateUsers=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# state and heartbeat get their mode explicitly
UMask=0077
LimitCORE=0
MemoryMax=64M

[Install]
WantedBy=multi-user.target
